{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "node": "20.11.0",
      "cache": {
        "disabled": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "node": "20.11.0",
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "disabled": false
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "node": "20.11.0",
      "android": {
        "buildType": "app-bundle"
      },
      "cache": {
        "disabled": false
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "node": "20.11.0",
      "cache": {
        "disabled": false
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
